# OpenAI API credentials
OPENAI_API_KEY=your_key_here

# Model used for research calls (must support tools / web search for grounded results)
OPENAI_MODEL=gpt-4o

# Optional: enable OpenAI hosted web_search tool. Set to "false" to disable and
# fall back to model knowledge only (will produce ungrounded, demo-only output).
ENABLE_WEB_SEARCH=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory where JSON reports are persisted
STORAGE_DIR=storage
