# Local Vite proxy. Set these in Vercel server environment for production.
MODEL_API_URL=http://localhost:8080
# Optional locally; required on the hosted container. Never use VITE_* for this.
MODEL_API_TOKEN=
SOURCING_API_URL=http://localhost:8000
SOURCING_API_TOKEN=
# OPENAI_API_KEY belongs ONLY in sourcing-engine/.env or the Python host, never VITE_*.
